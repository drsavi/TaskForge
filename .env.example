# Copy to .env in this folder and adjust values. Never commit .env.
#
# Required for docker compose up:
JWT_KEY=change-me-local-dev-secret-at-least-32-chars

# PostgreSQL (local development only)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=taskforge_db

# Optional API settings
JWT_ISSUER=TaskForgeApi
JWT_AUDIENCE=TaskForgeClient
JWT_EXPIRE_MINUTES=60
API_PORT=8080
